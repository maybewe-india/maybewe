{
  "expo": {
    "name": "MaybeWe",
    "slug": "solo-traveler",
    "version": "1.0.0",
    "scheme": "solo-traveler",
    "orientation": "portrait",
    "icon": "./frontend/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maybewe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow MaybeWe to capture your verification selfie to build community trust.",
        "NSPhotoLibraryUsageDescription": "Allow MaybeWe to select profile and travel history photos.",
        "NSLocationWhenInUseUsageDescription": "Allow MaybeWe to share your meeting spot with confirmed connections."
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./frontend/assets/android-icon-foreground.png",
        "backgroundImage": "./frontend/assets/android-icon-background.png",
        "monochromeImage": "./frontend/assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.maybewe.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./frontend/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./frontend/app"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MaybeWe to capture your verification selfie.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MaybeWe to access photos for your profile and travel history.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MaybeWe to share your meeting location with trusted connections."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "root": "./frontend/app"
      },
      "eas": {
        "projectId": "2f4ff259-267f-477f-b97e-6384c9b1ae55"
      }
    },
    "owner": "maybewe26s-team",
    "splash": {
      "image": "./frontend/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    }
  }
}
