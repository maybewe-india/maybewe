# Solo Traveler Supabase Environment Configuration
# Copy this file to .env and insert your real Supabase project credentials
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Open Map Vector Tiles (MapLibre GL JS + OpenFreeMap / Cloudflare R2 PMTiles)
# Zero Mapbox / Zero Google Keys
# Default open styles are preconfigured and require zero API keys:
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Optional: Self-hosted OSRM routing endpoint (falls back gracefully to built-in road geometry if omitted)
# EXPO_PUBLIC_ROUTING_API_URL=https://routing.maybewe.com
